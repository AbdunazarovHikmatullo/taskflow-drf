# Скопируйте в .env и замените значения
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (используется docker-compose)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
DATABASE_URL=postgres://taskflow:taskflow@db:5432/taskflow

# Время жизни JWT-токенов
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Суперпользователь, создаваемый при первом запуске контейнера (необязательно)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
